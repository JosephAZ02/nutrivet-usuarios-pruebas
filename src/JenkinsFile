def createEmailBody(String estado, String color, String mensaje) {
    return """
    <!DOCTYPE html>
    <html>
    <body style="font-family: Arial, sans-serif; background-color: #f5f5f5; padding: 20px;">

        <div style="max-width: 600px; margin: auto; background-color: white; border: 1px solid #ddd;">

            <div style="background-color: ${color}; color: white; padding: 15px 20px;">
                <h2 style="margin: 0;">NutriVet - ${estado}</h2>
            </div>

            <div style="padding: 20px; color: #333;">
                <p>Hola equipo,</p>

                <p>${mensaje}</p>

                <hr style="border: 0; border-top: 1px solid #ddd; margin: 20px 0;">

                <h3 style="font-size: 16px;">Información del proceso</h3>

                <p><strong>Proyecto:</strong> ${env.JOB_NAME}</p>
                <p><strong>Build:</strong> #${env.BUILD_NUMBER}</p>
                <p><strong>Duración:</strong> ${currentBuild.durationString}</p>
                <p><strong>Estado:</strong> <span style="color: ${color};">${estado}</span></p>
            </div>

            <div style="background-color: #f5f5f5; padding: 12px 20px; color: #777; font-size: 12px;">
                Correo automático generado por Jenkins.
            </div>

        </div>

    </body>
    </html>
    """
}

pipeline {
    agent any

    tools {
        maven 'Maven' 
        jdk 'JDK25'
    }

    environment {
        EMAIL_TO = 'nutrivetwg@gmail.com'
        REPO_URL = 'github.com/JosephAZ02/nutrivet-usuarios-pruebas.git'
    }

    stages {
        stage('1. Checkout DEV') {
            steps {
                echo 'Descargando código desde la rama DEV...'
                git branch: 'DEV', credentialsId: 'github-credentials', url: 'https://github.com/JosephAZ02/nutrivet-usuarios-pruebas.git'
            }
        }

        stage('2. Pruebas Unitarias Backend') {
            steps {
                dir('src/backend') {
                    echo 'Ejecutando pruebas unitarias...'
                    bat './mvnw test "-Dtest=UserServiceTest"'
                }
            }
        }

        stage('3. Levantar Servidores para Selenium') {
            steps {
                echo 'Inyectando archivo de configuración secreto...'
                
                withCredentials([file(credentialsId: 'app-local-properties', variable: 'APP_PROPS')]) {
                    
                    bat 'copy "%APP_PROPS%" "src\\backend\\src\\main\\resources\\application-local.properties"'

                    echo 'Iniciando Spring Boot y Vite...'
                    
                    dir('src/backend') {
                        powershell 'Start-Process -FilePath "cmd.exe" -ArgumentList "/c .\\mvnw spring-boot:run > backend.log 2>&1" -WindowStyle Hidden'
                    }
                    
                    dir('src/frontend') {
                        powershell 'Start-Process -FilePath "cmd.exe" -ArgumentList "/c npm run dev > frontend.log 2>&1" -WindowStyle Hidden'
                    }
                    
                    echo 'Esperando 60 segundos para que los servidores inicien...'
                    sleep(time: 60, unit: 'SECONDS') 

                    echo 'Verificando si el puerto 8080 (Backend) está abierto...'
                    script {
                        // Test-NetConnection verifica si el puerto está escuchando
                        def status = powershell(script: 'if (Test-NetConnection -ComputerName localhost -Port 8080 -InformationLevel Quiet) { exit 0 } else { exit 1 }', returnStatus: true)
                        
                        if (status != 0) {
                            echo 'ERROR: El Backend no está escuchando en el puerto 8080. Logs:'
                            dir('src/backend') {
                                bat 'type backend.log'
                            }
                            error("El Backend falló al arrancar. Revisa el log de arriba.")
                        } else {
                            echo '✅ Backend está en línea y listo para Selenium.'
                        }
                    }
                }
            }
        }

        stage('4. Pruebas Selenium (GUI)') {
            steps {
                dir('src/selenium-tests') {
                    echo 'Ejecutando pruebas de interfaz...'
                    bat 'mvn clean test'
                }
            }
        }

        stage('5. Detener Servidores') {
            steps {
                echo 'Deteniendo servidores (Back y Front)...'
                powershell '''
                    Get-Process -Name node -ErrorAction SilentlyContinue | Stop-Process -Force
                    $java = Get-NetTCPConnection -LocalPort 8080 -ErrorAction SilentlyContinue
                    if ($java) { Stop-Process -Id $java.OwningProcess -Force }
                '''
                sleep(time: 3, unit: 'SECONDS') 
            }
        }

        stage('6. Checkout a STG') {
            steps {
                echo 'Haciendo checkout automático a STG...'
                bat 'git config --global user.email "jyalfazu021421@gmail.com"'
                bat 'git config --global user.name "JosephAZ02"'
                bat 'if exist "src\\backend\\src\\main\\resources\\application-local.properties" del "src\\backend\\src\\main\\resources\\application-local.properties"'
                bat 'git reset --hard'
                bat 'git clean -fd'
                bat 'git checkout STG'
            }
        }

        stage('7. Merge y push a STG'){
            steps {
                bat 'git merge DEV --no-edit'
                withCredentials([usernamePassword(credentialsId: 'github-credentials', passwordVariable: 'GIT_PASS', usernameVariable: 'GIT_USER')]) {
                    bat "git push https://${GIT_USER}:${GIT_PASS}@${REPO_URL} STG"
                }
            }
        }

        stage('8. Checkout a MASTER') {
            steps {
                bat 'git checkout MASTER'
            }
        }

        stage('9. Merge y push a MASTER'){
            steps {
                bat 'git merge STG --no-edit'
                withCredentials([usernamePassword(credentialsId: 'github-credentials', passwordVariable: 'GIT_PASS', usernameVariable: 'GIT_USER')]) {
                    bat "git push https://${GIT_USER}:${GIT_PASS}@${REPO_URL} MASTER"
                }
            }
        }

        stage('10. Compilar Backend (Jar)') {
            steps {
                dir('src/backend') {
                    echo 'Compilando el Backend en un archivo .jar...'
                    // -DskipTests porque las pruebas ya pasaron en el Stage 2

                    bat './mvnw clean package -DskipTests'
                }
            }
        }

        stage('11. Compilar Frontend (React)') {
            steps {
                dir('src/frontend') {
                    echo 'Compilando el Frontend de React...'
                    bat 'npm install'
                    bat 'npm run build'
                }
            }
        }

        stage('12. Desplegar vía FTP') {
            steps {
                echo 'Subiendo Frontend y Backend a sus carpetas correspondientes...'
                ftpPublisher(
                    alwaysPublishFromMaster: false,
                    masterNodeName: '',
                    paramPublish: [parameterName: ""],
                    continueOnError: false,
                    failOnError: true,
                    publishers: [[
                        configName: 'FileZilla-Local', 
                        transfers: [
                           
                            [
                                sourceFiles: 'src/frontend/dist/**/*', 
                                removePrefix: 'src/frontend/dist',     
                                remoteDirectory: '/frontend', 
                                asciiMode: false, cleanRemote: true, excludes: '', flatten: false,
                                makeEmptyDirs: true, noDefaultExcludes: false, patternSeparator: '[, ]+',
                                remoteDirectorySDF: false, usePromotionTimestamp: false, useWorkspaceInPromotion: false, verbose: true
                            ],
                           
                            [
                                sourceFiles: 'src/backend/target/*.jar', 
                                removePrefix: 'src/backend/target',     
                                remoteDirectory: '/backend', 
                                asciiMode: false, cleanRemote: false, excludes: '', flatten: false,
                                makeEmptyDirs: true, noDefaultExcludes: false, patternSeparator: '[, ]+',
                                remoteDirectorySDF: false, usePromotionTimestamp: false, useWorkspaceInPromotion: false, verbose: true
                            ]
                        ]
                    ]]
                )
            }
        }

        
    }

    post {
        always {
            echo 'Limpiando procesos colgados...'
            powershell '''
                Get-Process -Name node -ErrorAction SilentlyContinue | Stop-Process -Force
                $java = Get-NetTCPConnection -LocalPort 8080 -ErrorAction SilentlyContinue
                if ($java) { Stop-Process -Id $java.OwningProcess -Force }
            '''
        }
        success {
            echo 'Enviando correo de éxito...'
            emailext (
                subject: "BUILD SUCCESS: NutriVet - #${env.BUILD_NUMBER}",
                mimeType: 'text/html',
                to: "${env.EMAIL_TO}",
                from: 'jenkins@nutrivet.com',
                body: createEmailBody(
                    "Pipeline Exitoso", 
                    "#198754", 
                    "El pipeline ha finalizado <b>satisfactoriamente</b>. Las pruebas pasaron, el código se mergeó y los archivos están en el servidor."
                )
            )
        }
        failure {
            echo 'Enviando correo de error...'
            emailext (
                subject: "BUILD FAILED: NutriVet - #${env.BUILD_NUMBER}",
                mimeType: 'text/html',
                to: "${env.EMAIL_TO}",
                from: 'jenkins@nutrivet.com',
                body: createEmailBody(
                    "Pipeline Fallido", 
                    "#dc3545", 
                    "El pipeline ha <b>fallado</b>. Los cambios <b>NO</b> se han subido a producción. Revisa la consola para más detalles."
                )
            )
        }
    }
}